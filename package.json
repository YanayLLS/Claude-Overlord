{
  "name": "overlord",
  "version": "1.34.0",
  "description": "Overlord — Claude Agent Manager",
  "main": "main.js",
  "scripts": {
    "preinstall": "node scripts/check-prerequisites.js",
    "test": "node --test",
    "start": "node scripts/bundle-xterm.js && electron .",
    "dev": "node scripts/bundle-xterm.js && electronmon .",
    "package": "node scripts/bundle-xterm.js && electron-builder --dir",
    "dist": "node scripts/bundle-xterm.js && electron-builder"
  },
  "dependencies": {
    "@xterm/addon-web-links": "^0.12.0",
    "electron-updater": "^6.8.3",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electronmon": "^2.0.4",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "com.overlord.claude",
    "productName": "Overlord",
    "icon": "assets/icon.ico",
    "publish": [
      {
        "provider": "github",
        "owner": "yanayLLS",
        "repo": "overlord",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "installerHeader": "assets/installer-header.bmp",
      "license": null,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Overlord"
    },
    "files": [
      "main.js",
      "worktree.js",
      "preload.js",
      "index.html",
      "ghost-core.js",
      "actions-core.js",
      "peer-core.js",
      "update-core.js",
      "pr-behind.js",
      "prompt-copy.js",
      "term-size-core.js",
      "resume-core.js",
      "state-core.js",
      "usage-core.js",
      "xterm-bundle.js",
      "xterm.css",
      "qr.js",
      "mobile.html",
      "browser/errors.js",
      "browser/view-wiring.js",
      "browser/snapshot-script.js",
      "browser/input-rebind.js",
      "browser/actions.js",
      "browser/registry.js",
      "mcp/tools.js",
      "mcp/server.js",
      "mcp/agent-config.js"
    ],
    "directories": {
      "output": "out"
    },
    "asar": true,
    "npmRebuild": false
  }
}
