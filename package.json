{
  "name": "overlord",
  "version": "1.170.8",
  "description": "Overlord — Claude Agent Manager",
  "main": "main.js",
  "scripts": {
    "preinstall": "node scripts/check-prerequisites.js",
    "test": "node --test",
    "start": "node scripts/bundle-xterm.js && node scripts/bundle-three.js && node scripts/bundle-md.js && electron .",
    "dev": "node scripts/bundle-xterm.js && node scripts/bundle-three.js && node scripts/bundle-md.js && electronmon .",
    "package": "node scripts/bundle-xterm.js && node scripts/bundle-three.js && node scripts/bundle-md.js && electron-builder --dir",
    "dist": "node scripts/bundle-xterm.js && node scripts/bundle-three.js && node scripts/bundle-md.js && electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.2.6",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electronmon": "^2.0.4",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.12",
    "three": "^0.160.1"
  },
  "build": {
    "appId": "com.overlord.claude",
    "productName": "Overlord",
    "icon": "assets/icon.ico",
    "publish": [
      {
        "provider": "github",
        "owner": "yanayLLS",
        "repo": "overlord",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "installerHeader": "assets/installer-header.bmp",
      "license": null,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Overlord"
    },
    "files": [
      "**/*",
      "!**/*.test.js",
      "!scripts/**",
      "!docs/**",
      "!*.md",
      "!package-lock.json",
      "!node_modules/node-pty/build/deps/**",
      "!node_modules/node-pty/build/Release/obj/**",
      "!node_modules/node-pty/build/**/*.{pdb,iobj,ipdb,exp,lib,sln,vcxproj,filters,tlog,log}",
      "!node_modules/node-pty/prebuilds/darwin-*/**",
      "!node_modules/node-pty/prebuilds/win32-arm64/**"
    ],
    "directories": {
      "output": "out"
    },
    "asar": true,
    "npmRebuild": false,
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Viewer",
        "icon": "assets/icon.ico"
      }
    ]
  }
}
